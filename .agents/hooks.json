{
  "academic-gate": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/academic_gate_hook.py pre",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/academic_gate_hook.py post",
            "timeout": 15
          }
        ]
      }
    ]
  }
}