# ==============================================================================
# ACADEMIC RESEARCH ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.

# ------------------------------------------------------------------------------
# 1. Google & Gemini API Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# ------------------------------------------------------------------------------
# 2. Google Drive Integration Paths (Google Drive for Desktop Mount)
# ------------------------------------------------------------------------------
# Path to local mount point of Academic Knowledge Base on Google Drive
NOTEBOOKLM_DRIVE_PATH=/path/to/GoogleDrive/NotebookLM - Academic Knowledge Base
LECTURE_OUTPUT_DIR=/path/to/GoogleDrive/NotebookLM - Academic Knowledge Base/Bai_Giang_Dong_Goi
IMAGE_VAULT_DIR=/path/to/GoogleDrive/NotebookLM - Academic Knowledge Base/Kho_Hinh_Anh
AUDIT_DOSSIER_DIR=/path/to/GoogleDrive/NotebookLM - Academic Knowledge Base

# ------------------------------------------------------------------------------
# 3. Workspace & Runtime Settings
# ------------------------------------------------------------------------------
WORKSPACE_ROOT=./
SYSTEM_TEMP_DIR=%TEMP%/academic_engine
LOG_LEVEL=INFO

# Recommended hardware concurrency limits (auto-generated by system_profiler.py)
MAX_CONCURRENCY=4
MEMORY_BUFFER_MB=4096

# ------------------------------------------------------------------------------
# 4. Researcher & Institutional Metadata
# ------------------------------------------------------------------------------
RESEARCHER_NAME=Lead Researcher
RESEARCHER_EMAIL=researcher@example.edu.vn
INSTITUTION_NAME=Department of Engineering Physics
GITHUB_USERNAME=your_github_username
