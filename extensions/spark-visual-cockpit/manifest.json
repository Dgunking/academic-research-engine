{
  "manifest_version": 3,
  "name": "Spark Visual Cockpit",
  "version": "2.5.0",
  "description": "Unified Decoupled Academic Workstation for Engineering Physics: Independent Visual Canvas, Living Document Reader Overlay, and Gemini Spark Deep Integration.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Spark Visual Cockpit v2.5",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.googleusercontent.com/*"
      ],
      "exclude_matches": [
        "https://gemini.google.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["drive-clipboard-helper.js"],
      "run_at": "document_start"
    }
  ]
}
